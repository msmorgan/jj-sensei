#!/usr/bin/env python3
"""Explain jj immutability for one or more revisions from an unpacked plugin."""

import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(PLUGIN_ROOT / "src"))

from jj_sensei.immutability import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
