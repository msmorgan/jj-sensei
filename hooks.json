{
  "jj-sensei-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/session_start.sh",
        "timeout": 10
      }
    ]
  },
  "jj-sensei-status": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/jj_status.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/jj_status.py",
        "timeout": 10
      }
    ]
  }
}
